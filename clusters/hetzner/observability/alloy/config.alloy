// Metrics and traces to Grafana Cloud (INFRA-85, INFRA-106, design in docs/architecture.md, Telemetry). Everything
// leaves through one OTLP/HTTP exporter, so the stack's write-only token (metrics:write, traces:write) is the only
// credential.
// Traces (INFRA-106) leave through the same exporter, so the token needs traces:write too. Logs (ZIF-89): Ziftbook's
// JSON app lines only, from ziftbook-staging and ziftbook-prod, so the token needs logs:write. No other namespace's
// logs are read: tbd-prod logs carry query strings until INFRA-110, and the data namespace never.

// ---- Export --------------------------------------------------------------------------------------------------------

otelcol.auth.basic "grafana_cloud" {
	username = sys.env("GRAFANA_CLOUD_INSTANCE_ID")
	password = sys.env("GRAFANA_CLOUD_TOKEN")
}

otelcol.exporter.otlphttp "grafana_cloud" {
	client {
		endpoint = sys.env("GRAFANA_CLOUD_OTLP_ENDPOINT")
		auth     = otelcol.auth.basic.grafana_cloud.handler
	}
}

otelcol.processor.batch "default" {
	output {
		metrics = [otelcol.exporter.otlphttp.grafana_cloud.input]
		traces  = [otelcol.exporter.otlphttp.grafana_cloud.input]
		logs    = [otelcol.exporter.otlphttp.grafana_cloud.input]
	}
}

// ---- Apps: OTLP/HTTP, one receiver per environment (alloy.observability.svc) ---------------------------------------
// 4318 takes tbd-prod and ziftbook-prod, 4319 tbd-staging and ziftbook-staging; the NetworkPolicy in alloy.yaml admits
// each namespace to its own port only (4320, the log-retention heartbeat, is further down). Each receiver's data goes
// through its memory limiter and its environment transform, then the shared filter and scrub, then export: the
// environment label comes from the port, not from the app, and app data never carries the names of the series the
// platform alerts read.
// Body cap 4MiB (the default is 20MiB): an app's largest request is a trace batch (the SDK's default 512 spans,
// uncompressed protobuf, about 1 MiB with SQL statements); its 60 s metric export is a few hundred KiB at most.

otelcol.receiver.otlp "apps_production" {
	http {
		endpoint              = "0.0.0.0:4318"
		max_request_body_size = "4MiB"
	}

	// Metrics and traces. Logs sent here are refused: app logs come only from the Ziftbook pod logs below.
	output {
		metrics = [otelcol.processor.memory_limiter.apps_production.input]
		traces  = [otelcol.processor.memory_limiter.apps_production.input]
	}
}

otelcol.receiver.otlp "apps_staging" {
	http {
		endpoint              = "0.0.0.0:4319"
		max_request_body_size = "4MiB"
	}

	output {
		metrics = [otelcol.processor.memory_limiter.apps_staging.input]
		traces  = [otelcol.processor.memory_limiter.apps_staging.input]
	}
}

// While Alloy's heap is over limit - spike_limit (144MiB) app data is refused (the SDK retries it later); over limit a
// GC is forced too. Both sit under GOMEMLIMIT (200MiB, alloy.yaml), so the limiter acts before the Go runtime starts
// collecting hard, and app traffic cannot push Alloy to the 256Mi container limit. The node, cAdvisor and log pipelines
// do not pass through it (their heap is about 44 MiB). Both limiters read the same process: keep their values equal.
otelcol.processor.memory_limiter "apps_production" {
	check_interval = "1s"
	limit          = "180MiB"
	spike_limit    = "36MiB"

	output {
		metrics = [otelcol.processor.transform.environment_production.input]
		traces  = [otelcol.processor.transform.environment_production.input]
	}
}

otelcol.processor.memory_limiter "apps_staging" {
	check_interval = "1s"
	limit          = "180MiB"
	spike_limit    = "36MiB"

	output {
		metrics = [otelcol.processor.transform.environment_staging.input]
		traces  = [otelcol.processor.transform.environment_staging.input]
	}
}

// deployment.environment.name is the receiver's, whatever the app sent: set on the resource (Grafana Cloud copies it
// to every series as deployment_environment_name), and deleted from data points and spans, where a key with the same
// label name would win over the resource's. Every spelling that maps to that label (".", "_", "-") goes.
otelcol.processor.transform "environment_production" {
	metric_statements {
		context    = "resource"
		statements = [
			`delete_matching_keys(attributes, "^deployment[^a-zA-Z0-9]environment[^a-zA-Z0-9]name$")`,
			`set(attributes["deployment.environment.name"], "production")`,
		]
	}

	metric_statements {
		context    = "datapoint"
		statements = [`delete_matching_keys(attributes, "^deployment[^a-zA-Z0-9]environment[^a-zA-Z0-9]name$")`]
	}

	trace_statements {
		context    = "resource"
		statements = [
			`delete_matching_keys(attributes, "^deployment[^a-zA-Z0-9]environment[^a-zA-Z0-9]name$")`,
			`set(attributes["deployment.environment.name"], "production")`,
		]
	}

	trace_statements {
		context    = "span"
		statements = [`delete_matching_keys(attributes, "^deployment[^a-zA-Z0-9]environment[^a-zA-Z0-9]name$")`]
	}

	output {
		metrics = [otelcol.processor.filter.apps.input]
		traces  = [otelcol.processor.filter.apps.input]
	}
}

otelcol.processor.transform "environment_staging" {
	metric_statements {
		context    = "resource"
		statements = [
			`delete_matching_keys(attributes, "^deployment[^a-zA-Z0-9]environment[^a-zA-Z0-9]name$")`,
			`set(attributes["deployment.environment.name"], "staging")`,
		]
	}

	metric_statements {
		context    = "datapoint"
		statements = [`delete_matching_keys(attributes, "^deployment[^a-zA-Z0-9]environment[^a-zA-Z0-9]name$")`]
	}

	trace_statements {
		context    = "resource"
		statements = [
			`delete_matching_keys(attributes, "^deployment[^a-zA-Z0-9]environment[^a-zA-Z0-9]name$")`,
			`set(attributes["deployment.environment.name"], "staging")`,
		]
	}

	trace_statements {
		context    = "span"
		statements = [`delete_matching_keys(attributes, "^deployment[^a-zA-Z0-9]environment[^a-zA-Z0-9]name$")`]
	}

	output {
		metrics = [otelcol.processor.filter.apps.input]
		traces  = [otelcol.processor.filter.apps.input]
	}
}

// App metrics never take the names of the platform's own series, which the rules in grafana/ alert on: the scrapes
// below (up, scrape_*, node_*, machine_*, container_*), Synthetic Monitoring (probe_*) and the log-retention heartbeat
// (log_retention_*). Matched loosely, in any case and with any other character (leading ones too) as the separator,
// because Grafana Cloud turns ".", "-" and the like into "_" when it maps an OTLP name to a Prometheus one. A name with
// no ASCII letter or digit goes too: the mapping would build it from the unit alone. Traces pass untouched.
otelcol.processor.filter "apps" {
	metrics {
		metric = [
			`IsMatch(name, "(?i)^[^a-zA-Z0-9]*(up|scrape|node|machine|container|probe|log[^a-zA-Z0-9]+retention)([^a-zA-Z0-9]|$)")`,
			`not IsMatch(name, "[a-zA-Z0-9]")`,
		]
	}

	output {
		metrics = [otelcol.processor.transform.scrub.input]
		traces  = [otelcol.processor.transform.scrub.input]
	}
}

// Backstop for the INFRA-84 allowlist, by attribute key only (span names, status messages and links are not touched):
// these attributes carry tokens, emails and client addresses (and explode cardinality), so they never leave the node
// even if an app sets them, on a data point, a span or span event, its scope or its resource (Grafana Cloud turns
// resource attributes into target_info labels). Old semconv names included.
// Default error_mode (propagate): a failing statement drops the batch instead of exporting it unscrubbed. Deleting a
// key can merge two data points that differed only by it (Mimir then rejects the duplicate); only an app that breaks
// INFRA-84 hits that.
otelcol.processor.transform "scrub" {
	metric_statements {
		context    = "resource"
		statements = [`delete_matching_keys(attributes, "^(url[.].*|http[.]request[.]header[.].*|http[.](url|target|client_ip)|client[.]address|net[.]sock[.]peer[.]addr|exception[.](message|stacktrace))$")`]
	}

	metric_statements {
		context    = "scope"
		statements = [`delete_matching_keys(attributes, "^(url[.].*|http[.]request[.]header[.].*|http[.](url|target|client_ip)|client[.]address|net[.]sock[.]peer[.]addr|exception[.](message|stacktrace))$")`]
	}

	metric_statements {
		context    = "datapoint"
		statements = [`delete_matching_keys(attributes, "^(url[.].*|http[.]request[.]header[.].*|http[.](url|target|client_ip)|client[.]address|net[.]sock[.]peer[.]addr|exception[.](message|stacktrace))$")`]
	}

	trace_statements {
		context    = "resource"
		statements = [`delete_matching_keys(attributes, "^(url[.].*|http[.]request[.]header[.].*|http[.](url|target|client_ip)|client[.]address|net[.]sock[.]peer[.]addr|exception[.](message|stacktrace))$")`]
	}

	trace_statements {
		context    = "scope"
		statements = [`delete_matching_keys(attributes, "^(url[.].*|http[.]request[.]header[.].*|http[.](url|target|client_ip)|client[.]address|net[.]sock[.]peer[.]addr|exception[.](message|stacktrace))$")`]
	}

	trace_statements {
		context    = "span"
		statements = [`delete_matching_keys(attributes, "^(url[.].*|http[.]request[.]header[.].*|http[.](url|target|client_ip)|client[.]address|net[.]sock[.]peer[.]addr|exception[.](message|stacktrace))$")`]
	}

	trace_statements {
		context    = "spanevent"
		statements = [`delete_matching_keys(attributes, "^(url[.].*|http[.]request[.]header[.].*|http[.](url|target|client_ip)|client[.]address|net[.]sock[.]peer[.]addr|exception[.](message|stacktrace))$")`]
	}

	output {
		metrics = [otelcol.processor.batch.default.input]
		traces  = [otelcol.processor.batch.default.input]
	}
}

// ---- Log-retention heartbeat: OTLP/HTTP on 4320 (INFRA-130) -------------------------------------------------------
// Only the log-retention DaemonSet reaches this port (NetworkPolicy in alloy.yaml). Each pass posts one gauge of a few
// hundred bytes, hence the small body cap; any other metric is dropped, and traces and logs are refused.

otelcol.receiver.otlp "heartbeat" {
	http {
		endpoint              = "0.0.0.0:4320"
		max_request_body_size = "64KiB"
	}

	output {
		metrics = [otelcol.processor.filter.heartbeat.input]
	}
}

otelcol.processor.filter "heartbeat" {
	metrics {
		metric = [`name != "log_retention_last_success_timestamp_seconds"`]
	}

	output {
		metrics = [otelcol.processor.batch.default.input]
	}
}

// ---- Node and k3s: scraped every 60s, converted to OTLP ------------------------------------------------------------

otelcol.receiver.prometheus "scraped" {
	output {
		metrics = [otelcol.processor.batch.default.input]
	}
}

// Node: the embedded node_exporter, reading the host's /proc and /sys (read-only mounts). Disk space comes from
// cAdvisor (container_fs_*{id="/"}, one series per disk, the DB volume on db-1 included), so the host's / is not
// mounted at all.
prometheus.exporter.unix "node" {
	procfs_path    = "/host/proc"
	sysfs_path     = "/host/sys"
	set_collectors = ["cpu", "diskstats", "loadavg", "meminfo", "pressure", "vmstat"]

	disk {
		device_exclude = "^(loop|ram|dm-|sr)\\d+$"
	}
}

// The exporter labels its target job="integrations/unix", instance=<pod name>, which changes on every rollout.
discovery.relabel "node" {
	targets = prometheus.exporter.unix.node.targets

	rule {
		target_label = "job"
		replacement  = "node"
	}

	rule {
		target_label = "instance"
		replacement  = sys.env("NODE_NAME")
	}
}

prometheus.scrape "node" {
	targets         = discovery.relabel.node.output
	scrape_interval = "60s"
	forward_to      = [otelcol.receiver.prometheus.scraped.receiver]
}

// cAdvisor on this node's kubelet (10250), with the pod's token (RBAC: nodes/metrics only). The kubelet's own
// /metrics is not scraped: on k3s it carries the whole control plane, about 58,000 series, which tripled Alloy's heap
// (measured 44 to 172 MiB) for pod counts that cAdvisor already gives.
prometheus.scrape "cadvisor" {
	targets = [{
		"__address__" = sys.env("HOST_IP") + ":10250",
		"instance"    = sys.env("NODE_NAME"),
	}]
	job_name          = "cadvisor"
	metrics_path      = "/metrics/cadvisor"
	scheme            = "https"
	bearer_token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"
	scrape_interval   = "60s"

	tls_config {
		ca_file = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
	}

	forward_to = [prometheus.relabel.cadvisor.receiver]
}

// cAdvisor: per-container CPU, memory, throttling, OOM and pod network, plus the whole node ("/", with its disk space)
// and the k3s service (k3s and containerd). Other systemd slices, cgroup ids, image names and veth interfaces are
// dropped.
prometheus.relabel "cadvisor" {
	rule {
		source_labels = ["__name__"]
		regex         = "up|machine_memory_bytes|container_cpu_usage_seconds_total|container_cpu_cfs_(throttled_)?periods_total|container_memory_working_set_bytes|container_memory_rss|container_spec_memory_limit_bytes|container_oom_events_total|container_network_(receive|transmit)_bytes_total|container_fs_(usage|limit)_bytes"
		action        = "keep"
	}

	// Disk space only for the node's real disks: not per container, not loop devices or tmpfs. Hetzner disks are SCSI:
	// the root disk is /dev/sda1 and, on db-1, the database volume (local-path PVCs at /var/lib/rancher/k3s/storage) is
	// /dev/sdb. root, nvme and xvd are the other common names, kept so a different server type still reports.
	rule {
		source_labels = ["__name__", "id", "device"]
		regex         = "container_fs_(usage|limit)_bytes;/;/dev/(root|nvme.+|xvd.+|sd.+)|(up|machine_memory_bytes|container_(cpu|memory|network|oom|spec)_[^;]*);[^;]*;[^;]*"
		action        = "keep"
	}

	// Series of a pod, the two cgroups that are not pods, and the two series with neither.
	rule {
		source_labels = ["__name__", "pod", "id"]
		regex         = "(up|machine_memory_bytes);;|[^;]+;[^;]+;.*|[^;]+;;(/|/system\\.slice/k3s\\.service)"
		action        = "keep"
	}

	// Each pod also has a pause (sandbox) container: container="", name=<sandbox id>. Once name and image are dropped
	// its CPU and memory series collide with the pod cgroup's (container="", no name) and overwrite them. Keep only
	// its network series, which exist nowhere else.
	rule {
		source_labels = ["__name__", "pod", "container", "name"]
		regex         = "container_(cpu|memory|spec|oom)[^;]*;[^;]+;;.+"
		action        = "drop"
	}

	// A pod's series are named by namespace, pod and container; the cgroup id only adds a uid. While a container
	// restarts, its old and new cgroups share these labels for a scrape or two, and the last one read wins.
	rule {
		source_labels = ["pod"]
		regex         = ".+"
		target_label  = "id"
		replacement   = ""
	}

	rule {
		source_labels = ["interface"]
		regex         = "veth.*|cni0|flannel.*"
		action        = "drop"
	}

	rule {
		regex  = "image|name"
		action = "labeldrop"
	}

	forward_to = [otelcol.receiver.prometheus.scraped.receiver]
}

// ---- Ziftbook pod logs (ZIF-89): read through the kube API, no host mount ----------------------------------------
// RBAC (alloy.yaml) allows pods and pods/log in ziftbook-staging and ziftbook-prod only. Each Alloy pod watches only
// its own node's pods, so every container is tailed once.

discovery.kubernetes "ziftbook_pods" {
	role = "pod"

	namespaces {
		names = ["ziftbook-staging", "ziftbook-prod"]
	}

	selectors {
		role  = "pod"
		field = "spec.nodeName=" + sys.env("NODE_NAME")
	}
}

// service_name: ziftbook-api, -worker and -migrations, as the backend image names its traces; ziftbook-frontend.
discovery.relabel "ziftbook_pods" {
	targets = discovery.kubernetes.ziftbook_pods.targets

	rule {
		source_labels = ["__meta_kubernetes_namespace"]
		target_label  = "namespace"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_container_name"]
		target_label  = "container"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_name"]
		target_label  = "pod"
	}

	rule {
		source_labels = ["container"]
		target_label  = "service_name"
		replacement   = "ziftbook-$1"
	}

	rule {
		source_labels = ["container"]
		regex         = "backend"
		target_label  = "service_name"
		replacement   = "ziftbook-api"
	}

	rule {
		source_labels = ["container"]
		regex         = "migrate"
		target_label  = "service_name"
		replacement   = "ziftbook-migrations"
	}
}

loki.source.kubernetes "ziftbook_pods" {
	targets    = discovery.relabel.ziftbook_pods.output
	forward_to = [loki.process.app_json.receiver]
}

// Only lines that parse as a JSON object carrying ts, level, logger and msg leave the node; tracebacks, alembic and
// Next.js output and anything else are dropped (the privacy notice covers the app's own JSON records only). The body
// itself ships as is (the INFRA-84 scrub covers metrics and traces only): what a record holds is the app's logs.py
// to keep clean.
loki.process "app_json" {
	// Positions live in the emptyDir, so a new Alloy pod (every config change) re-reads each container's current log
	// file. Older lines were sent by the previous pod; 1h still covers an Alloy outage before it would lose lines.
	stage.drop {
		older_than          = "1h"
		drop_counter_reason = "replay"
	}

	// A missing key extracts as nil, which a per-key drop stage would keep, hence one computed bool.
	stage.json {
		drop_malformed = true
		expressions    = {keep = "ts != `null` && level != `null` && logger != `null` && msg != `null`"}
	}

	stage.drop {
		source              = "keep"
		value               = "false"
		drop_counter_reason = "not_app_json"
	}

	forward_to = [otelcol.receiver.loki.app_json.receiver]
}

otelcol.receiver.loki "app_json" {
	output {
		logs = [otelcol.processor.transform.loki_labels.input]
	}
}

// otelcol.receiver.loki puts every Loki label in log attributes on an empty resource, one resource per entry. Move
// them to the resource attributes Grafana Cloud turns into stream labels (service_name, service_namespace,
// k8s_namespace_name, k8s_container_name; service_namespace makes Tempo's trace-to-logs link match). The pod stays a
// log attribute (structured metadata), so the two backend replicas share one stream; everything else is dropped.
// shortcut: per-entry resource values rely on loki.process forwarding one entry at a time; re-test on an Alloy bump.
otelcol.processor.transform "loki_labels" {
	log_statements {
		context    = "log"
		statements = [
			`set(resource.attributes["service.name"], attributes["service_name"])`,
			`set(resource.attributes["service.namespace"], "ziftbook")`,
			`set(resource.attributes["k8s.namespace.name"], attributes["namespace"])`,
			`set(resource.attributes["k8s.container.name"], attributes["container"])`,
			`set(attributes["k8s.pod.name"], attributes["pod"])`,
			`keep_keys(attributes, ["k8s.pod.name"])`,
		]
	}

	output {
		logs = [otelcol.processor.batch.default.input]
	}
}
