{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadBackupInfrastructureState",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucket*",
        "s3:GetLifecycleConfiguration",
        "s3:GetEncryptionConfiguration",
        "s3:GetAccelerateConfiguration",
        "s3:GetReplicationConfiguration",
        "s3:GetObjectLockConfiguration",
        "s3:ListBucket",
        "s3:ListAllMyBuckets"
      ],
      "Resource": [
        "arn:aws:s3:::tbd-mysql-backups-884686184019",
        "arn:aws:s3:::tbd-mysql-backups-884686184019/*"
      ]
    },
    {
      "Sid": "ReadKeyMetadata",
      "Effect": "Allow",
      "Action": [
        "kms:DescribeKey",
        "kms:GetKeyPolicy",
        "kms:GetKeyRotationStatus",
        "kms:ListResourceTags"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/component": "mysql-offhost-backup"
        }
      }
    },
    {
      "Sid": "ListKeyAliasesTakesNoResource",
      "Effect": "Allow",
      "Action": "kms:ListAliases",
      "Resource": "*"
    },
    {
      "Sid": "ReadBackupIdentities",
      "Effect": "Allow",
      "Action": [
        "iam:Get*",
        "iam:List*"
      ],
      "Resource": [
        "arn:aws:iam::884686184019:user/k3s-backup-uploader",
        "arn:aws:iam::884686184019:role/github-actions-backup-probe",
        "arn:aws:iam::884686184019:role/tfc-backups-provisioner",
        "arn:aws:iam::884686184019:role/tfc-backups-plan",
        "arn:aws:iam::884686184019:oidc-provider/app.terraform.io",
        "arn:aws:iam::884686184019:oidc-provider/token.actions.githubusercontent.com"
      ]
    },
    {
      "Sid": "ReadOwnIdentity",
      "Effect": "Allow",
      "Action": [
        "sts:GetCallerIdentity",
        "iam:ListOpenIDConnectProviders"
      ],
      "Resource": "*"
    },
    {
      "Sid": "NeverReadBackupContent",
      "Effect": "Deny",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:GetObjectAttributes",
        "kms:Decrypt",
        "kms:ReEncryptFrom"
      ],
      "Resource": "*"
    }
  ]
}
