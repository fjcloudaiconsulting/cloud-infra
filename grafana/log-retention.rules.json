{
  "title": "log-retention",
  "interval": 300,
  "rules": [
    {
      "uid": "log-retention-stale",
      "title": "LogRetentionStale",
      "folderUID": "platform",
      "ruleGroup": "log-retention",
      "orgID": 1,
      "condition": "B",
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": {
            "from": 604800,
            "to": 0
          },
          "datasourceUid": "grafanacloud-prom",
          "model": {
            "refId": "A",
            "expr": "time() - max by (instance) (max_over_time(log_retention_last_success_timestamp_seconds{instance!=\"\"}[7d]))",
            "instant": true,
            "range": false
          }
        },
        {
          "refId": "B",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "refId": "B",
            "type": "threshold",
            "expression": "A",
            "conditions": [
              {
                "evaluator": {
                  "type": "gt",
                  "params": [
                    10800
                  ]
                }
              }
            ]
          }
        }
      ],
      "for": "0s",
      "noDataState": "Alerting",
      "execErrState": "KeepLast",
      "labels": {
        "severity": "critical",
        "component": "node"
      },
      "annotations": {
        "summary": "Log retention on node {{ $labels.instance }} has not reported success for 3 hours (no data at all: no node ever has). Container logs reach the privacy policy's 7-day limit about 21 hours after the last success. See the Request log retention runbook.",
        "runbook_url": "https://github.com/fjcloudaiconsulting/cloud-infra/blob/main/docs/runbooks.md#request-log-retention"
      },
      "notification_settings": {
        "receiver": "owner-email",
        "group_wait": "30s",
        "repeat_interval": "12h"
      }
    }
  ]
}
