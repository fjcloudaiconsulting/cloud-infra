{
  "title": "tbd-app",
  "interval": 60,
  "rules": [
    {
      "uid": "tbd-csp-reports-dropped",
      "title": "TbdCspReportsDropped",
      "folderUID": "platform",
      "ruleGroup": "tbd-app",
      "orgID": 1,
      "condition": "B",
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": {
            "from": 4500,
            "to": 0
          },
          "datasourceUid": "grafanacloud-prom",
          "model": {
            "refId": "A",
            "expr": "sum by (outcome) (tbd_security_csp_reports_total{service_name=\"tbd-api\", deployment_environment_name=\"production\", outcome=\"global_budget\"} - (last_over_time(tbd_security_csp_reports_total{service_name=\"tbd-api\", deployment_environment_name=\"production\", outcome=\"global_budget\"}[1d] offset 1h) or tbd_security_csp_reports_total{service_name=\"tbd-api\", deployment_environment_name=\"production\", outcome=\"global_budget\"} * 0))",
            "instant": true,
            "range": false
          }
        },
        {
          "refId": "B",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "refId": "B",
            "type": "threshold",
            "expression": "A",
            "conditions": [
              {
                "evaluator": {
                  "type": "gt",
                  "params": [
                    0.5
                  ]
                }
              }
            ]
          }
        }
      ],
      "for": "0s",
      "noDataState": "OK",
      "execErrState": "KeepLast",
      "labels": {
        "severity": "warning",
        "component": "tbd"
      },
      "annotations": {
        "summary": "TBD production dropped {{ printf \"%.0f\" $values.A.Value }} CSP report(s) in the last hour: the global budget was spent, so later reports are not stored. See the TBD app alerts runbook.",
        "runbook_url": "https://github.com/fjcloudaiconsulting/cloud-infra/blob/main/docs/runbooks.md#tbd-app-alerts"
      },
      "notification_settings": {
        "receiver": "owner-email",
        "group_wait": "30s",
        "repeat_interval": "24h"
      }
    },
    {
      "uid": "tbd-csp-report-sink-failing",
      "title": "TbdCspReportSinkFailing",
      "folderUID": "platform",
      "ruleGroup": "tbd-app",
      "orgID": 1,
      "condition": "B",
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": {
            "from": 4500,
            "to": 0
          },
          "datasourceUid": "grafanacloud-prom",
          "model": {
            "refId": "A",
            "expr": "sum by (outcome) (tbd_security_csp_reports_total{service_name=\"tbd-api\", deployment_environment_name=\"production\", outcome=~\"counter_unavailable|write_failed\"} - (last_over_time(tbd_security_csp_reports_total{service_name=\"tbd-api\", deployment_environment_name=\"production\", outcome=~\"counter_unavailable|write_failed\"}[1d] offset 1h) or tbd_security_csp_reports_total{service_name=\"tbd-api\", deployment_environment_name=\"production\", outcome=~\"counter_unavailable|write_failed\"} * 0))",
            "instant": true,
            "range": false
          }
        },
        {
          "refId": "B",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "refId": "B",
            "type": "threshold",
            "expression": "A",
            "conditions": [
              {
                "evaluator": {
                  "type": "gt",
                  "params": [
                    0.5
                  ]
                }
              }
            ]
          }
        }
      ],
      "for": "0s",
      "noDataState": "OK",
      "execErrState": "KeepLast",
      "labels": {
        "severity": "warning",
        "component": "tbd"
      },
      "annotations": {
        "summary": "TBD production could not store {{ printf \"%.0f\" $values.A.Value }} CSP report(s) in the last hour ({{ $labels.outcome }}): the sink fails open. See the TBD app alerts runbook.",
        "runbook_url": "https://github.com/fjcloudaiconsulting/cloud-infra/blob/main/docs/runbooks.md#tbd-app-alerts"
      },
      "notification_settings": {
        "receiver": "owner-email",
        "group_wait": "30s",
        "repeat_interval": "24h"
      }
    },
    {
      "uid": "tbd-process-down",
      "title": "TbdProcessDown",
      "folderUID": "platform",
      "ruleGroup": "tbd-app",
      "orgID": 1,
      "condition": "B",
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "grafanacloud-prom",
          "model": {
            "refId": "A",
            "expr": "absent_over_time(tbd_process_up{service_name=\"tbd-api\", deployment_environment_name=\"production\"}[5m]) or absent_over_time(tbd_process_up{service_name=\"tbd-scheduler\", deployment_environment_name=\"production\"}[5m]) or label_replace(absent_over_time(container_memory_working_set_bytes{job=\"cadvisor\", namespace=\"tbd-prod\", container=\"frontend\"}[5m]), \"service_name\", \"tbd-frontend\", \"\", \"\")",
            "instant": true,
            "range": false
          }
        },
        {
          "refId": "B",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "refId": "B",
            "type": "threshold",
            "expression": "A",
            "conditions": [
              {
                "evaluator": {
                  "type": "gt",
                  "params": [
                    0.5
                  ]
                }
              }
            ]
          }
        }
      ],
      "for": "5m",
      "noDataState": "OK",
      "execErrState": "KeepLast",
      "labels": {
        "severity": "critical",
        "component": "tbd"
      },
      "annotations": {
        "summary": "TBD production: {{ $labels.service_name }} has reported nothing for 10 minutes (process down, or its metrics export broken). See the TBD app alerts runbook.",
        "runbook_url": "https://github.com/fjcloudaiconsulting/cloud-infra/blob/main/docs/runbooks.md#tbd-app-alerts"
      },
      "notification_settings": {
        "receiver": "owner-email",
        "group_wait": "30s",
        "repeat_interval": "4h"
      }
    },
    {
      "uid": "tbd-staging-process-down",
      "title": "TbdStagingProcessDown",
      "folderUID": "platform",
      "ruleGroup": "tbd-app",
      "orgID": 1,
      "condition": "B",
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "grafanacloud-prom",
          "model": {
            "refId": "A",
            "expr": "absent_over_time(tbd_process_up{service_name=\"tbd-api\", deployment_environment_name=\"staging\"}[5m]) or absent_over_time(tbd_process_up{service_name=\"tbd-mcp\", deployment_environment_name=\"staging\"}[5m]) or label_replace(absent_over_time(container_memory_working_set_bytes{job=\"cadvisor\", namespace=\"tbd-staging\", container=\"frontend\"}[5m]), \"service_name\", \"tbd-frontend\", \"\", \"\")",
            "instant": true,
            "range": false
          }
        },
        {
          "refId": "B",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "refId": "B",
            "type": "threshold",
            "expression": "A",
            "conditions": [
              {
                "evaluator": {
                  "type": "gt",
                  "params": [
                    0.5
                  ]
                }
              }
            ]
          }
        }
      ],
      "for": "5m",
      "noDataState": "OK",
      "execErrState": "KeepLast",
      "labels": {
        "severity": "warning",
        "component": "tbd"
      },
      "annotations": {
        "summary": "TBD staging: {{ $labels.service_name }} has reported nothing for 10 minutes (process down, or its metrics export broken). See the TBD app alerts runbook.",
        "runbook_url": "https://github.com/fjcloudaiconsulting/cloud-infra/blob/main/docs/runbooks.md#tbd-app-alerts"
      },
      "notification_settings": {
        "receiver": "owner-email",
        "group_wait": "30s",
        "repeat_interval": "24h"
      }
    },
    {
      "uid": "tbd-no-superadmin",
      "title": "TbdNoSuperadmin",
      "folderUID": "platform",
      "ruleGroup": "tbd-app",
      "orgID": 1,
      "condition": "B",
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "grafanacloud-prom",
          "model": {
            "refId": "A",
            "expr": "max(tbd_platform_active_superadmins{service_name=\"tbd-scheduler\", deployment_environment_name=\"production\"})",
            "instant": true,
            "range": false
          }
        },
        {
          "refId": "B",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "refId": "B",
            "type": "threshold",
            "expression": "A",
            "conditions": [
              {
                "evaluator": {
                  "type": "lt",
                  "params": [
                    0.5
                  ]
                }
              }
            ]
          }
        }
      ],
      "for": "0s",
      "noDataState": "OK",
      "execErrState": "KeepLast",
      "labels": {
        "severity": "critical",
        "component": "tbd"
      },
      "annotations": {
        "summary": "TBD production has no active platform superadmin: /admin refuses everyone. See the TBD app alerts runbook.",
        "runbook_url": "https://github.com/fjcloudaiconsulting/cloud-infra/blob/main/docs/runbooks.md#tbd-app-alerts"
      },
      "notification_settings": {
        "receiver": "owner-email",
        "group_wait": "30s",
        "repeat_interval": "4h"
      }
    },
    {
      "uid": "tbd-superadmin-probe-stale",
      "title": "TbdSuperadminProbeStale",
      "folderUID": "platform",
      "ruleGroup": "tbd-app",
      "orgID": 1,
      "condition": "B",
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "grafanacloud-prom",
          "model": {
            "refId": "A",
            "expr": "(time() - max(tbd_platform_active_superadmins_probed_at_seconds{service_name=\"tbd-scheduler\", deployment_environment_name=\"production\"})) or on() vector(1e9)",
            "instant": true,
            "range": false
          }
        },
        {
          "refId": "B",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "refId": "B",
            "type": "threshold",
            "expression": "A",
            "conditions": [
              {
                "evaluator": {
                  "type": "gt",
                  "params": [
                    2700
                  ]
                }
              }
            ]
          }
        }
      ],
      "for": "15m",
      "noDataState": "OK",
      "execErrState": "KeepLast",
      "labels": {
        "severity": "warning",
        "component": "tbd"
      },
      "annotations": {
        "summary": "TBD production's superadmin probe has not read the database for 45+ min (or never since the scheduler started): the no-superadmin alert is blind. See the TBD app alerts runbook.",
        "runbook_url": "https://github.com/fjcloudaiconsulting/cloud-infra/blob/main/docs/runbooks.md#tbd-app-alerts"
      },
      "notification_settings": {
        "receiver": "owner-email",
        "group_wait": "30s",
        "repeat_interval": "24h"
      }
    }
  ]
}
